# =====================================================================
# UBA SENTINEL BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# =====================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT Authentication Secret
JWT_SECRET=uba_sentinel_super_secure_jwt_secret_change_in_production_2026
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL / Supabase)
# Leave empty to use built-in local persistent storage with zero external dependencies
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Machine Learning Service Configuration
# Modes: 'builtin' (runs embedded JS Isolation Forest & statistical UBA) | 'python_service' (proxies to Python Flask/FastAPI)
ML_ENGINE_MODE=builtin
PYTHON_ML_SERVICE_URL=http://localhost:5001

# Tamper-Evident Audit Salt / Secret
AUDIT_CHAIN_SALT=uba_sentinel_audit_hmac_secret_sha256_chain_2026
